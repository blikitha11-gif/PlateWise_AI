# WasteWise AI Environment Variables

# SQLite Database Location (defaults to ./wastewise.db)
DATABASE_URL=sqlite:///./wastewise.db

# Server Configuration
PORT=8000
HOST=127.0.0.1

# Optional: AWS AI Integration (AWS Strands Agents / Amazon Bedrock)
# Leave empty to use the built-in deterministic Local Expert Rule Engine fallback
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
